EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Google Maps browser key (bundled) — restrict to HTTP referrers https://bop.in/*
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-browser-restricted-maps-key
# Google Maps Android SDK key — set as an EAS env var (not EXPO_PUBLIC_), restrict to package com.rehrms.app + SHA-1s
GOOGLE_MAPS_ANDROID_KEY=your-android-restricted-maps-key
# Google Maps Map ID (Cloud Console > Map Management) for Advanced Markers; falls back to DEMO_MAP_ID
EXPO_PUBLIC_GOOGLE_MAPS_MAP_ID=your-production-map-id

EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-uuid
# Use / for domain-root hosting or /hrms/ for a subfolder deployment.
EXPO_PUBLIC_WEB_BASE_PATH=/
# Change to true only after applying the background-location Supabase migration.
EXPO_PUBLIC_LOCATION_RPC_ENABLED=false
# Set these with `supabase secrets set`; never prefix them with EXPO_PUBLIC_:
# SMS_OTP_API_KEY=server-only-sms-provider-key
# AISENSY_API_KEY=server-only-whatsapp-provider-key
