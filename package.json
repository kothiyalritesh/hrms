{
  "name": "my-app",
  "main": "index.js",
  "version": "1.2.0",
  "scripts": {
    "dev": "EXPO_PACKAGER_PROXY_URL=https://$REPLIT_DEV_DOMAIN REACT_NATIVE_PACKAGER_HOSTNAME=$REPLIT_DEV_DOMAIN npx expo start",
    "start": "npx expo start",
    "android": "npx expo start --android",
    "ios": "npx expo start --ios",
    "web": "npx expo start --web",
    "preview:web": "node scripts/serve-web-production.js",
    "lint": "npx expo lint",
    "typecheck": "tsc --noEmit",
    "typecheck:location": "tsc -p tsconfig.location.json",
    "test": "jest --runInBand",
    "export:web": "powershell -ExecutionPolicy Bypass -File ./export_web.ps1",
    "deploy:web": "powershell -ExecutionPolicy Bypass -File ./deploy_bop_web.ps1",
    "deploy:web:eas-preview": "npm run export:web && eas deploy --prod --environment production",
    "update:installed": "eas update --channel preview --environment preview --platform all",
    "update:production": "eas update --channel production --environment production --platform all",
    "check:format": "prettier --check \"**/*.{js,ts,tsx,css,json}\"",
    "format": "prettier --write \"**/*.{js,ts,tsx,css,json}\""
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-picker/picker": "^2.11.4",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/native-stack": "^7.3.16",
    "@supabase/supabase-js": "^2.39.0",
    "@types/xlsx": "^0.0.35",
    "cors": "^2.8.6",
    "expo": "~56.0.18",
    "expo-blur": "~56.0.4",
    "expo-constants": "^56.0.18",
    "expo-crypto": "~56.0.4",
    "expo-developer-mode": "file:modules/expo-developer-mode",
    "expo-device": "~56.0.4",
    "expo-document-picker": "~56.0.4",
    "expo-file-system": "~56.0.8",
    "expo-font": "~56.0.7",
    "expo-glass-effect": "~56.0.4",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.11",
    "expo-image-manipulator": "~56.0.23",
    "expo-image-picker": "~56.0.22",
    "expo-linking": "~56.0.16",
    "expo-location": "~56.0.22",
    "expo-notifications": "~56.0.26",
    "expo-secure-store": "~56.0.4",
    "expo-sharing": "~56.0.23",
    "expo-splash-screen": "~56.0.14",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.6",
    "expo-system-ui": "~56.0.5",
    "expo-task-manager": "~56.0.24",
    "expo-updates": "~56.0.23",
    "expo-web-browser": "~56.0.6",
    "express": "^5.2.1",
    "node-fetch": "^2.7.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-keyboard-controller": "1.21.6",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "^13.16.1",
    "react-native-worklets": "0.8.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.85.3",
    "@types/jest": "29.5.14",
    "@types/node": "^26.6.3",
    "@types/react": "~19.2.14",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~56.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^29.7.0",
    "jest-expo": "~56.0.5",
    "prettier": "3.6.2",
    "supabase": "^2.84.0",
    "typescript": "~6.0.3"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ]
  }
}
